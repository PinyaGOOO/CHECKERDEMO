[Unit]
Description=Web Demo Checker assessment service
After=network-online.target pve-cluster.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/web-demo-checker
ExecStart=/usr/bin/node /opt/web-demo-checker/src/server.js
Environment=NODE_ENV=production
Environment=PORT=8007
Environment=CHECKER_MODE=live
Environment=CHECKER_TRANSPORT=local
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_PACKET

[Install]
WantedBy=multi-user.target
