PORT=8007
CONSOLE_HTTPS_PORT=8443
CONSOLE_TLS_KEY=/etc/web-demo-checker/tls.key
CONSOLE_TLS_CERT=/etc/web-demo-checker/tls.crt
CHECKER_MODE=mock
CHECKER_SSH_ALIAS=checker
CHECKER_TRANSPORT=ssh

# Fill these values when Proxmox integration is enabled.
PROXMOX_BASE_URL=https://proxmox.example.local:8006
PROXMOX_NODE=pve
PROXMOX_TOKEN_ID=checker@pve!assessment
PROXMOX_TOKEN_SECRET=replace-me
PROXMOX_VERIFY_TLS=true
